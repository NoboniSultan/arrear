# Leave unset for local dev — the Vite dev server proxies /api to the
# Express backend (see vite.config.js), so requests can stay relative.
#
# Set this only when deploying the built frontend somewhere that isn't
# same-origin with the backend (e.g. Cloudflare Pages talking to a Render
# backend — see DEPLOY.md). Example:
# VITE_API_URL=https://arrear-backend.onrender.com
VITE_API_URL=
