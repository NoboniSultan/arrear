# Copy this file to .env and fill in local values. Never commit the real .env.

# Arrear's own Postgres app database — NOT Epic Clarity.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arrear_dev
DB_USER=postgres
DB_PASSWORD=changeme

# Server port
PORT=3000

# Ollama model used to draft plain-language reports. Must already be pulled
# locally, e.g. `ollama pull llama3.1`.
OLLAMA_MODEL=llama3.1

# development | production. Controls whether the session cookie requires
# HTTPS (secure: true) — leave as development for local http testing.
NODE_ENV=development

# Signs session cookies. Generate a real long random value for your local
# .env — never reuse this placeholder, never commit the real value.
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
