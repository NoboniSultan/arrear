# Copy this file to .env and fill in local values. Never commit the real .env.

# Arrear's own Postgres app database — NOT Epic Clarity.
# Used only when DATABASE_URL (below) is unset — that's the local dev case.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arrear_dev
DB_USER=postgres
DB_PASSWORD=changeme

# Set only when deploying against a hosted Postgres (e.g. Neon's free tier —
# see DEPLOY.md). Takes precedence over the DB_* vars above when set. Leave
# unset for local dev.
DATABASE_URL=

# Server port
PORT=3000

# Base URL of the Ollama server. Defaults to localhost:11434 if unset —
# override only when the backend runs somewhere that can't reach Ollama at
# localhost (e.g. deployed on Render, reaching Ollama on your Mac over
# Tailscale — see DEPLOY.md Part 5 for important caveats on the free tier).
OLLAMA_URL=

# Ollama model used to draft plain-language reports. Must already be pulled
# locally, e.g. `ollama pull llama3.1`.
OLLAMA_MODEL=llama3.1

# development | production. Controls whether the session cookie requires
# HTTPS (secure: true) and cross-site delivery (sameSite: none) — leave as
# development for local http testing.
NODE_ENV=development

# Signs session cookies. Generate a real long random value for your local
# .env — never reuse this placeholder, never commit the real value.
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# The exact origin of the deployed frontend (e.g. https://arrear.pages.dev)
# — enables CORS for that one origin only. Leave unset for local dev, where
# the Vite proxy keeps frontend and backend same-origin and CORS isn't used
# at all.
ALLOWED_ORIGIN=
